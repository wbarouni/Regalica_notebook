# Database
DB_URL=postgres://postgres:postgres@postgres:5432/notebook
DB_SCHEMA=nbk

# Server
SERVER_PORT=5200
LOG_LEVEL=info

# Microservices
EMBED_API_URL=http://embedder:8000
RERANKER_API_URL=http://reranker:8000
LLM_API_URL=http://ollama:11434
CLUSTERER_API_URL=http://clusterer:8002

# LLM Configuration - Single model (legacy)
LLM_MODEL_NAME=qwen2:7b-instruct

# LLM Configuration - Multi-model routing (Phase 1)
LLM_MODEL_FAST=qwen2.5:3b-instruct-q4_k_m
LLM_MODEL_DEEP=qwen2:7b-instruct-q4_k_m
LLM_MODEL_MICRO=tinyllama:latest
OLLAMA_KEEP_ALIVE=3600

# LLM Parameters
LLM_CHAT_TIMEOUT_MS=60000
LLM_NUM_PREDICT=300
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.9
LLM_REPEAT_PENALTY=1.1

# RAG Configuration
RAG_TOP_K=8
RAG_CITATIONS_MIN=0
RAG_CONFIDENCE_THRESHOLD=0.1
RAG_MIN_COSINE_SCORE=0.15
RAG_MIN_CHUNK_LENGTH=30
HNSW_EF_SEARCH=64
RAG_BM25_COARSE_LIMIT=200

# Reranker
RERANKER_MAX_INPUT_CHARS=300
RERANKER_MAX_CANDIDATES=8
RERANKER_ALPHA=0.30
RERANKER_BETA=0.70
RERANKER_TIMEOUT_MS=20000

# Embeddings
EMBED_MODEL_NAME=intfloat/multilingual-e5-large
RAG_CHUNK_MAX_TOKENS=800
RAG_CHUNK_OVERLAP_TOKENS=200
CHUNK_TOKENS_MAX=1800
CHUNK_OVERLAP_PCT=0.25

# Ingestion
MAX_UPLOAD_MB=100
ALLOWED_MIME=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/html,text/plain
OCR_ENABLE=false

# Studio Features
FEATURE_MINDMAP=true
FEATURE_WORKSPACES=true
FEATURE_REALTIME_MINDMAP=false
LLM_NODE_SUMMARY_MODEL=qwen2:1.5b
MIN_CLUSTER_SIZE=5
MIN_SAMPLES=5
CLUSTER_METRIC=cosine

# URLs
BACKEND_EXTERNAL_URL=
FRONTEND_EXTERNAL_URL=
CORS_ALLOWED_ORIGINS=

# Feature Flags (Phase 2-4)
ENABLE_MODEL_ROUTING=true
ENABLE_JSON_FORMAT=false
ENABLE_PROMPT_PACKS=false
ENABLE_CITATION_UX=false
